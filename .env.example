# Copy this file to .env and fill in real values. .env is git-ignored and must never be committed.
#
# This .env is read by `docker compose` for the Caddy stack only - unrelated to Flutter's own
# --dart-define build-time config.

# Public domain for the production Caddy TLS cert. Not used locally, but Caddy still needs the env
# var to exist, so leave a placeholder value.
DOMAIN=hobbs.bssd.co.uk

# Uncomment for local runs so Caddy doesn't need root to bind 80/443. Leave unset in production.
# HTTP_PORT=8080
# HTTPS_PORT=8443
